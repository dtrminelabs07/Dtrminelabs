generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  DEMO
}
enum UploadStatus {
  COMPLETED
  PENDING
  UPLOADED
  LIMIT
  OUT_OF_STOCK
  HOLIDAY
}
enum ActivityAction {
  CREATED
  UPDATED
}

model User {
  id           String        @id @default(cuid())
  name         String
  username     String?       @unique
  email        String        @unique
  passwordHash String
  role         UserRole      @default(STAFF)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdUploads DailyUpload[] @relation("CreatedUploads")
  updatedUploads DailyUpload[] @relation("UpdatedUploads")
  activities   ActivityLog[]
  accountNotes AccountNote[]
  demoAccounts Account[]     @relation("DemoAccounts")
  productionProducts ProductionProduct[] @relation("ProductionProductCreator")
  productionComments ProductionComment[] @relation("ProductionCommentAuthor")
  productionProgressChanges ProductionProgressChange[] @relation("ProductionProgressActor")
}

model Account {
  id        String        @id @default(cuid())
  name      String
  username  String?
  avatarUrl String?
  platform  String?
  core      String
  subCore   String?
  internalNotes String?      @map("notes")
  passwordEncrypted String?
  isActive  Boolean       @default(true)
  ownerId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  uploads   DailyUpload[]
  activities ActivityLog[]
  privateNotes AccountNote[]
  productionProducts ProductionProduct[]
  owner     User?         @relation("DemoAccounts", fields: [ownerId], references: [id], onDelete: Restrict)
  @@index([isActive, core, subCore])
  @@index([ownerId, isActive, core, subCore])
  @@index([name])
}

model AccountNote {
  id        String   @id @default(cuid())
  accountId String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  @@index([accountId, createdAt])
  @@index([authorId])
}

model DailyUpload {
  id          String        @id @default(cuid())
  accountId   String
  date        DateTime      @db.Date
  status      UploadStatus
  notes       String?
  createdById String
  updatedById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("CreatedUploads", fields: [createdById], references: [id])
  updatedBy   User          @relation("UpdatedUploads", fields: [updatedById], references: [id])
  activities  ActivityLog[]
  @@unique([accountId, date])
  @@index([date, status])
  @@index([accountId, date])
}

model ActivityLog {
  id            String          @id @default(cuid())
  accountId     String
  dailyUploadId String?
  actorId       String
  action        ActivityAction
  previousStatus UploadStatus?
  newStatus     UploadStatus?
  description   String
  createdAt     DateTime        @default(now())
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  dailyUpload   DailyUpload?    @relation(fields: [dailyUploadId], references: [id], onDelete: SetNull)
  actor         User            @relation(fields: [actorId], references: [id])
  @@index([createdAt])
  @@index([accountId, createdAt])
}

model ProductionProduct {
  id             String   @id @default(cuid())
  accountId      String
  creationKey    String?
  name           String
  description    String?
  targetCount    Int
  completedCount Int      @default(0)
  isArchived     Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy      User     @relation("ProductionProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments       ProductionComment[]
  progressHistory ProductionProgressChange[]
  @@index([accountId, isArchived, updatedAt])
  @@index([createdAt])
  @@unique([accountId, creationKey])
}

model ProductionComment {
  id        String   @id @default(cuid())
  productId String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  product   ProductionProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  author    User?    @relation("ProductionCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  @@index([productId, createdAt])
  @@index([authorId])
}

model ProductionProgressChange {
  id                    String   @id @default(cuid())
  productId             String
  actorId               String
  previousCompletedCount Int
  newCompletedCount      Int
  previousTargetCount    Int?
  newTargetCount         Int?
  note                   String?
  createdAt              DateTime @default(now())
  product                ProductionProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor                  User     @relation("ProductionProgressActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([productId, createdAt])
  @@index([actorId])
}

